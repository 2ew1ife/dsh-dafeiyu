{
  "name": "dsh-startup-animation",
  "version": "2.1.0",
  "private": true,
  "description": "DSH 狂三启动主题，基于 KylinQ01/dsh-startup-animation；仅做黑红金外观适配与 DSH 0.2 设置兼容。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "FORK.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node check.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "startup",
    "splash",
    "wallpaper"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
